# Copy this file to `.env.r2` (strictly gitignored) and fill in your Cloudflare R2 S3 API token values.
# Create an R2 API Token at: Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens -> Create API Token
# Permissions: Object Read & Write (scoped to bucket `melody-media`).

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=melody-media
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
